<?xml version="1.0"?>
<Container version="2">
  <Name>Copi</Name>
  <Repository>copi:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>Copi - Database backup scheduler (SQLite, MySQL, PostgreSQL)</Overview>
  <Category>Backup:</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/lbeaufils06/icon/refs/heads/main/copi250.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Copi web port" Type="Port" Display="always" Required="true" Mask="false">8092</Config>

  <Config Name="Config Directory" Target="/config" Default="/mnt/user/appdata/copi/config" Mode="rw" Description="Persistent config directory (SQLite DB)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/copi/config</Config>
  <Config Name="Backups Directory" Target="/app/backups" Default="/mnt/user/backups/copi" Mode="rw" Description="Backup storage directory" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/export/copi/</Config>

  <Config Name="Spring Profile" Target="SPRING_PROFILES_ACTIVE" Default="prod" Mode="" Description="Spring active profile" Type="Variable" Display="advanced" Required="true" Mask="false">prod</Config>
  <Config Name="SQLite URL" Target="SPRING_DATASOURCE_URL" Default="jdbc:sqlite:/config/copi.db" Mode="" Description="SQLite database path" Type="Variable" Display="advanced" Required="true" Mask="false">jdbc:sqlite:/config/copi.db</Config>
  <Config Name="Backup Directory Variable" Target="APP_BACKUP_DIR" Default="/app/backups" Mode="" Description="Internal backup directory used by the app" Type="Variable" Display="advanced" Required="true" Mask="false">/app/backups</Config>

  <Config Name="MASTER_KEY" Target="MASTER_KEY" Default="change-me" Mode="" Description="Encryption master key" Type="Variable" Display="advanced" Required="false" Mask="true">change-me</Config>
  <Config Name="Admin Password" Target="COPI_ADMIN_PASSWORD" Default="" Mode="" Description="Admin password" Type="Variable" Display="always" Required="true" Mask="true">copi</Config>
  <Config Name="Session Timeout (minutes)" Target="SESSION_TIMEOUT" Default="30" Mode="" Description="Session duration before automatic logout" Type="Variable" Display="advanced" Required="false" Mask="false">30</Config>

  <TailscaleStateDir/>
</Container>
