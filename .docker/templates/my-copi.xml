<?xml version="1.0"?>
<Container version="2">
  <Name>Copi</Name>
  <Repository>copi:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>Copi - Database backup scheduler (SQLite, MySQL, PostgreSQL)</Overview>
  <Category>Backup:</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/lbeaufils06/icon/refs/heads/main/copi250.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Port Web Copi" Type="Port" Display="always" Required="true" Mask="false">8092</Config>
  <Config Name="Database Data" Target="/app/data" Default="/mnt/user/appdata/copi/data" Mode="rw" Description="SQLite database directory" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/copi</Config>
  <Config Name="Backups Directory" Target="/app/backups" Default="/mnt/user/backups/copi" Mode="rw" Description="Backup storage directory" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/export/copi/</Config>
  <Config Name="MASTER_KEY" Target="MASTER_KEY" Default="change-me" Mode="" Description="Encryption master key" Type="Variable" Display="advanced" Required="false" Mask="true">change-me</Config>
  <Config Name="Admin Password" Target="COPI_ADMIN_PASSWORD" Default="" Mode="" Description="Mot de passe administrateur : copi" Type="Variable" Display="always" Required="true" Mask="true">copi</Config>
  <Config Name="Session Timeout (minutes)" Target="SESSION_TIMEOUT" Default="30" Mode="" Description="Durée de session en minutes avant déconnexion automatique" Type="Variable" Display="advanced" Required="false" Mask="false">30</Config>
  <Config Name="MySQL Dump Path" Target="MYSQLDUMP_PATH" Default="mysqldump" Mode="{3}" Description="Path to mysqldump binary (Linux default: mysqldump)" Type="Variable" Display="advanced" Required="false" Mask="false">/usr/bin/mysqldump</Config>
  <Config Name="PostgreSQL Dump Path" Target="PGDUMP_PATH" Default="pg_dump" Mode="{3}" Description="Path to pg_dump binary (Linux default: pg_dump)" Type="Variable" Display="advanced" Required="false" Mask="false">/usr/bin/pg_dump</Config>
  <Config Name="PostgreSQL DumpAll Path" Target="PGDUMPALL_PATH" Default="pg_dumpall" Mode="{3}" Description="Path to pg_dumpall binary (Linux default: pg_dumpall)" Type="Variable" Display="advanced" Required="false" Mask="false">/usr/bin/pg_dumpall</Config>
  <TailscaleStateDir/>
</Container>