# Runtime profile
SPRING_PROFILES_ACTIVE=prod

# Admin account (required)
COPI_ADMIN_PASSWORD=

# Application crypto secret (required, keep the same value after first startup)
MASTER_KEY=

# Server
COPI_HTTP_PORT=8092
SERVER_PORT=8080
SESSION_TIMEOUT=30

# Container file permissions (Docker)
UMASK=077
PUID=99
PGID=100

# SQLite
SPRING_DATASOURCE_URL=jdbc:sqlite:/config/copi.db
SPRING_DATASOURCE_DRIVER=org.sqlite.JDBC

# Backup directory (inside container)
APP_BACKUP_DIR=/app/backups

# Dump tools (inside container or local PATH)
POSTGRES_CLIENT_MAJOR=16
MYSQLDUMP_PATH=mysql-mysqldump
MARIADUMP_PATH=mariadb-dump
PGDUMP_PATH=postgresql-pg-dump
PGDUMPALL_PATH=postgresql-pg-dumpall
MONGODUMP_PATH=mongodump
